# AWS过敏原系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况配置

# ================================================
# AWS凭证配置（长期模式）
# ================================================

# 警告：不要在代码中硬编码凭证！
# 使用以下方式之一：
# 1. 通过 aws configure 配置
# 2. 在系统环境变量中设置
# 3. 使用 .env 文件（仅开发环境）

# AWS凭证（如果需要通过环境变量设置）
# AWS_ACCESS_KEY_ID=AKIA...              # 以AKIA开头的Access Key ID
# AWS_SECRET_ACCESS_KEY=...             # 对应的Secret Access Key
# AWS_SESSION_TOKEN=                    # 可选，如果使用临时凭证

# ================================================
# AWS服务配置
# ================================================

# 通用默认区域（会被下面的 per-service 区域覆盖）
AWS_REGION=ap-southeast-2

# ---- 分区域配置（重要）----
# 本项目资源跨两个区域：Bedrock/KB 在 ap-southeast-2，
# DynamoDB/S3/Textract 在 us-east-1。每个服务读自己的覆盖变量，
# 缺省回退到 AWS_REGION。
BEDROCK_REGION=ap-southeast-2      # Bedrock 运行时
KB_REGION=ap-southeast-2           # Bedrock Knowledge Base
DYNAMODB_REGION=us-east-1          # DynamoDB 表
S3_REGION=us-east-1                # 菜单上传桶
TEXTRACT_REGION=us-east-1          # Textract OCR

# Bedrock配置
# Use an inference profile id (au.* / global.*) - the bare foundation-model
# id (e.g. "anthropic.claude-opus-4-6-v1") is rejected by Converse with
# ValidationException. au.* is lowest-latency from ap-southeast-2.
BEDROCK_MODEL_ID=au.anthropic.claude-opus-4-6-v1
# Bedrock Knowledge Base for the compliance RAG layer (aws engine).
# Empty/unset = RAG silently degrades to local docs/ search.
KNOWLEDGE_BASE_ID=CBFZTLLUHU
# BEDROCK_ENDPOINT_URL=            # 可选自定义端点

# S3配置（用于上传菜单文档）
# S3_BUCKET=allergen-demo-dev-menu-uploads-669232219904
# S3_PREFIX=uploads/

# DynamoDB配置（用于存储分析结果）
# DYNAMODB_TABLE=allergen-demo-dev-menu-items
# DYNAMODB_ENDPOINT_URL=           # 本地开发时使用

# ================================================
# 应用运行模式
# ================================================

# 运行模式：true = 本地模拟，false = AWS真实服务
LOCAL_MODE=false

# 开发调试
DEBUG=true
LOG_LEVEL=INFO

# ================================================
# 应用特定配置
# ================================================

# Flask应用
FLASK_APP=application.py
FLASK_ENV=development
FLASK_RUN_PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ================================================
# 使用说明
# ================================================
# 1. 复制此文件为 .env
# 2. 配置必要的AWS凭证 (aws configure，IAM 长期密钥写入 ~/.aws/credentials)
# 3. 推荐直接运行 setup_aws_env.ps1 设置分区域环境变量（等效于本文件内容）
# 4. 启动应用: cd app; .\.venv\Scripts\python.exe application.py
# 5. 浏览器访问 http://localhost:8000